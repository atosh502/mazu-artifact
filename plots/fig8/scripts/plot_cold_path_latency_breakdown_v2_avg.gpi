# Paths are relative to the project root; override with
#   gnuplot -e "data_dir='...'; output_dir='...'" <script>
if (!exists("script_dir")) script_dir = "plots/fig8/scripts"
if (!exists("data_dir")) data_dir = "plots/fig8/data-paper"
if (!exists("output_dir")) output_dir = "plots/fig8/outputs/paper"

load script_dir."/style.gpi"

# set terminal pdfcairo enhanced color font "Helvetica, 12"
# set output "latency_breakdown_v2.pdf"

set terminal postscript eps enhanced color size 3.3in,2.7in font "Helvetica,20" linewidth 2 dashlength 2 pointscale 2
set output output_dir."/fig8b-latency-breakdown-for-fortio-server.eps"

set style data histogram
set style histogram rowstacked
set style fill solid 0.8 border -1

set boxwidth 0.9

set ylabel "Latency (ms)"
# set ylabel "Latency (ms)" font "Helvetica, 16"
# set title "Mazu Latency Breakdown by Operation (50 RPS, 4min)" font "Helvetica, 16"

set key top left maxcols 1 maxrows 5 width -4 samplen 1.5 height -1
set key reverse Left
# set key outside bottom center font "Helvetica, 10" maxrows 2
# set xtics font "Helvetica, 12"
# set ytics font "Helvetica, 12"
# set key font "Helvetica, 12"

set grid ytics lt 0 lw 0.5

DAT = data_dir."/plot_latency_breakdown_v2_avg.dat"

# Stacked bars: server ops per percentile, with e2e as linespoints on top
# Data columns: Label kc_fetch counter_att rbe_proof challenge_resp token_review e2e
plot keyentry with boxes fs solid 0.8 ls 6 title "kc\\_fetch", \
     keyentry with boxes fs solid 0.8 ls 2 title "counter\\_attestation", \
     keyentry with boxes fs solid 0.8 ls 1 title "rbe\\_proof", \
     keyentry with boxes fs solid 0.8 ls 4 title "challenge\\_resp", \
     keyentry with boxes fs solid 0.8 ls 3 title "token\\_review", \
     DAT using 2:xtic(1) notitle ls 6, \
     '' using 4 notitle ls 2, \
     '' using 6 notitle ls 1, \
     '' using 8 notitle ls 4, \
     '' using 10 notitle ls 3

