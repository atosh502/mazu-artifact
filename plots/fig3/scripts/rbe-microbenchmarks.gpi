#!/usr/bin/env gnuplot

# Paths are relative to the project root; override with
#   gnuplot -e "data_dir='...'; output_dir='...'" <script>
if (!exists("script_dir")) script_dir = "plots/fig3/scripts"
if (!exists("data_dir")) data_dir = "plots/fig3/data-paper"
if (!exists("output_dir")) output_dir = "plots/fig3/outputs/paper"

# Plot every point_step-th number of users, and xauto=1 to autoscale the
# users axis (the paper's tics stop at 1M users)
#   gnuplot -e "point_step=4; xauto=1" <script>
if (!exists("point_step")) point_step = 100
if (!exists("xauto")) xauto = 0

load script_dir."/style.gpi"
set output output_dir."/fig3-rbe-microbenchmarks.eps"

set grid ytics
set tics nomirror
set xlabel "Max Users"
set ylabel "Time (ms)"
set key top left


# set xtics ( \
#         "25"          25, \
#         "100"        100, \
#         "225"        225, \
#         "400"        400, \
#         "625"        625, \
#         "900"        900, \
#         "1225"      1225)

if (xauto) {
    set xtics autofreq
} else {
    set xtics ( \
            ""         4, \
            "62.5K"   62500, \
            "250K"    250000, \
            "562.5K"  562500, \
            "1M"    1000000)
}

# convert nanoseconds to milliseconds (1,000,000 ns = 1 ms)
plot data_dir."/rbe-genkey-reguser.dat" \
        using 1:($2/1e6) every point_step with linespoints linestyle 1 linewidth 4 pointtype 6 title 'KeyGen', \
     '' using 1:($3/1e6) every point_step with linespoints linestyle 2 linewidth 4 pointtype 7 title 'Reg'
