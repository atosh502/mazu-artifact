# Paths are relative to the project root; override with
#   gnuplot -e "data_dir='...'; output_dir='...'" <script>
if (!exists("script_dir")) script_dir = "plots/fig6/scripts"
if (!exists("data_dir")) data_dir = "plots/fig6/data-paper"
if (!exists("output_dir")) output_dir = "plots/fig6/outputs/paper"

# RPS tics to draw, space-separated and ascending, instead of the paper's
# 200-1200 axis, and yauto=1 to autoscale the pod axis instead of the paper's
# fixed range; override with
#   gnuplot -e "rps_values='100 200 400'; yauto=1" <script>
if (!exists("yauto")) yauto = 0

load script_dir."/style.gpi"

set terminal postscript eps enhanced color size 3.3in,2.7in font "Helvetica,20" linewidth 2 dashlength 2 pointscale 2
set output output_dir."/fig6b-total-ready-pods.eps"

set xlabel "Queries per second (QPS)"
set ylabel "Ready pods"

set key top left maxrows 3
# set key off

set grid ytics
set tics nomirror

if (exists("rps_values")) {
    N_RPS = words(rps_values)
    RPS_LO = word(rps_values, 1) + 0
    RPS_HI = word(rps_values, N_RPS) + 0
    RPS_PAD = (RPS_HI > RPS_LO) ? 0.05 * (RPS_HI - RPS_LO) : 0.1 * RPS_LO
    set xrange [RPS_LO - RPS_PAD : RPS_HI + RPS_PAD]
    set xtics ()
    do for [i = 1:N_RPS] {
        eval sprintf('set xtics add (%s)', word(rps_values, i))
    }
} else {
    set xrange [50:1250]
    # set xtics (100, 200, 400, 600, 800, 1000, 1200)
    set xtics (200, 400, 600, 800, 1000, 1200)
}
if (yauto) {
    # headroom above the lines for the key
    set yrange [*:*]
    set offsets 0, 0, graph 0.3, graph 0.1
} else {
    set yrange [25:120]
}

ISTIO_PODS_FILE = data_dir."/sn-pod-growth/plot_sn_pod_growth_pooled_istio.dat"
MAZU_PODS_FILE = data_dir."/sn-pod-growth/plot_sn_pod_growth_pooled_mazu.dat"

plot \
    ISTIO_PODS_FILE using 1:2 title "Istio" with linespoints linestyle 1 linewidth 2 pointtype 5 pointsize 0.4 dashtype 1, \
    MAZU_PODS_FILE  using 1:2 title "Mazu"  with linespoints linestyle 2 linewidth 2 pointtype 5 pointsize 0.4 dashtype 1