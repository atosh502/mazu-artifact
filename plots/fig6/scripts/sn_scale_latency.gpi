# Paths are relative to the project root; override with
#   gnuplot -e "data_dir='...'; output_dir='...'" <script>
if (!exists("script_dir")) script_dir = "plots/fig6/scripts"
if (!exists("data_dir")) data_dir = "plots/fig6/data-paper"
if (!exists("output_dir")) output_dir = "plots/fig6/outputs/paper"

# RPS tics to draw, space-separated and ascending, instead of the paper's
# 200-1200 axis; override with
#   gnuplot -e "rps_values='100 200 400'" <script>

load script_dir."/style.gpi"

set terminal postscript eps enhanced color size 3.3in,2.7in font "Helvetica,20" linewidth 2 dashlength 2 pointscale 2
set output output_dir."/fig6a-end-to-end-latency.eps"

set xlabel "Queries per second (QPS)"
set ylabel "Latency (ms)"

# set key top outside left horizontal maxrows 1 samplen 1
set key top left maxcols 1 samplen 1.5
# set key off

set logscale y

set grid ytics
set tics nomirror

if (exists("rps_values")) {
    N_RPS = words(rps_values)
    RPS_LO = word(rps_values, 1) + 0
    RPS_HI = word(rps_values, N_RPS) + 0
    RPS_PAD = (RPS_HI > RPS_LO) ? 0.05 * (RPS_HI - RPS_LO) : 0.1 * RPS_LO
    set xrange [RPS_LO - RPS_PAD : RPS_HI + RPS_PAD]
    set xtics ()
    do for [i = 1:N_RPS] {
        eval sprintf('set xtics add (%s)', word(rps_values, i))
    }
} else {
    set xrange [50:1250]
    # set xtics (100, 200, 400, 600, 800, 1000, 1200)
    set xtics (200, 400, 600, 800, 1000, 1200)
}

set format y "%.0s%c"

ISTIO_LATENCY_FILE = data_dir."/sn-scale/plot_sn_latency_pooled_istio.dat"
MAZU_LATENCY_FILE = data_dir."/sn-scale/plot_sn_latency_pooled_mazu.dat"

plot \
    keyentry with lines linestyle 1 linewidth 2 title "Istio", \
    keyentry with lines linestyle 2 linewidth 2 title "Mazu", \
    keyentry title " ", \
    keyentry with linespoints linecolor rgb "black" linewidth 2 pointtype 7  pointsize 0.4 dashtype (1,2) title "p50", \
    keyentry with linespoints linecolor rgb "black" linewidth 2 pointtype 7  pointsize 0.4 dashtype (5,2.5) title "p90", \
    keyentry with linespoints linecolor rgb "black" linewidth 2 pointtype 7 pointsize 0.4 dashtype 1 title "p99", \
    ISTIO_LATENCY_FILE     using 2:3 notitle with linespoints linestyle 1 linewidth 2 pointtype 7  pointsize 0.4 dashtype (1,2), \
    ISTIO_LATENCY_FILE     using 2:4 notitle with linespoints linestyle 1 linewidth 2 pointtype 7  pointsize 0.4 dashtype (5,2.5), \
    ISTIO_LATENCY_FILE     using 2:5 notitle with linespoints linestyle 1 linewidth 2 pointtype 7 pointsize 0.4 dashtype 1, \
    MAZU_LATENCY_FILE using 2:3 notitle with linespoints linestyle 2 linewidth 2 pointtype 7  pointsize 0.4 dashtype (1,2), \
    MAZU_LATENCY_FILE using 2:4 notitle with linespoints linestyle 2 linewidth 2 pointtype 7  pointsize 0.4 dashtype (5,2.5), \
    MAZU_LATENCY_FILE using 2:5 notitle with linespoints linestyle 2 linewidth 2 pointtype 7 pointsize 0.4 dashtype 1