# Paths are relative to the project root; override with
#   gnuplot -e "data_dir='...'; output_dir='...'" <script>
if (!exists("script_dir")) script_dir = "plots/fig7/scripts"
if (!exists("data_dir")) data_dir = "plots/fig7/data-paper"
if (!exists("output_dir")) output_dir = "plots/fig7/outputs/paper"

# Scales to draw and the RPS tics, space-separated; override with
#   gnuplot -e "scales='1x 2x'; rps_values='100 200 400'" <script>
if (!exists("scales")) scales = "1x 4x 16x"
if (!exists("rps_values")) rps_values = "100 200 400 800 1200 2000"

load script_dir."/style.gpi"

set terminal postscript eps enhanced color size 3.3in,2.7in font "Helvetica,20" linewidth 2 dashlength 2 pointscale 2
set output output_dir."/fig7a-p99-latency.eps"

set xlabel "Queries per second (QPS)"
set ylabel "p99 latency (ms)"

set logscale x
set logscale y

N_RPS = words(rps_values)
set xrange [0.9 * word(rps_values, 1) : 1.15 * word(rps_values, N_RPS)]
set xtics ()
do for [i = 1:N_RPS] {
    eval sprintf('set xtics add (%s)', word(rps_values, i))
}
# set xtics (200, 400, 600, 800, 1000, 1200)

set format y "%.0s%c"  # 10000 -> 10k
set grid ytics
set ytics
set tics nomirror

# set key top left maxrows 1 width 0.5 spacing 0.4
set key outside top center maxrows 2
set key width -2
set key spacing 1

DATA = data_dir."/pooled_latency_by_scale.dat"

# Column order of the data file's scales; the p99 Istio/Mazu pair of scale k
# (1-based) is in columns 24 + 2k / 25 + 2k.
ALL_SCALES = "1x 2x 4x 8x 16x 32x"
scale_index(s) = sum [k = 1:words(ALL_SCALES)] (word(ALL_SCALES, k) eq s ? k : 0)
p99_istio(i) = 24 + 2 * scale_index(word(scales, i))
p99_mazu(i)  = p99_istio(i) + 1

# One dash pattern per drawn scale, in the order given by scales
set dashtype 11 (5,2.5)
set dashtype 12 (1,2)
set dashtype 13 (8,2,1,2)
set dashtype 14 (3,3)
set dashtype 15 (8,4)
array DT = [1, 11, 12, 13, 14, 15]

N = words(scales)

plot \
    keyentry with lines linestyle 1 linewidth 2 title "Istio", \
    keyentry with lines linestyle 2 linewidth 2 title "Mazu", \
    for [i = 1:N] keyentry with linespoints linecolor rgb "black" linewidth 2 pointtype 7 pointsize 0.4 dashtype DT[i] title word(scales, i), \
    for [i = 1:N] DATA using 1:(column(p99_istio(i))) notitle with linespoints linestyle 1 pointtype 7 pointsize 0.4 linewidth 2 dashtype DT[i], \
    for [i = 1:N] DATA using 1:(column(p99_mazu(i))) notitle with linespoints linestyle 2 pointtype 7 pointsize 0.4 linewidth 2 dashtype DT[i]
